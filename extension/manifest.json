{
  "manifest_version": 3,
  "name": "Simplify Apply Assist",
  "short_name": "Apply Assist",
  "version": "1.0.0",
  "description": "Fills job application forms from your own Simplify package. You review and click Submit yourself.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://simplify-platform-tau.vercel.app/*",
    "http://localhost:3210/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://hh.kz/*",
    "https://*.hh.kz/*",
    "https://hh.ru/*",
    "https://*.hh.ru/*"
  ],
  "action": {
    "default_title": "Simplify Apply Assist",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
